# App Store releases for Textream on iPhone and iPad.
#
# Authenticates with an App Store Connect API key. Set these first:
#   ASC_KEY_ID      the key's ID
#   ASC_ISSUER_ID   the issuer ID shown in App Store Connect > Users and Access > Integrations
#   ASC_KEY_PATH    path to the key's .p8 file
#
# Then, from the repository root:
#   fastlane ios release
#
# Any key can upload a build. Creating the App Store version and submitting it
# for review need a key with the App Manager or Admin role; with a narrower key,
# run `fastlane ios archive_build` and `fastlane ios upload_build`, then submit
# in App Store Connect or later with `fastlane ios submit_build`.
#
# The version and build number come from the TextreamiOS target in the Xcode
# project, and the What's New text from fastlane/metadata/en-US/release_notes.txt.

require "xcodeproj"

opt_out_usage
default_platform(:ios)

PROJECT = "Textream/Textream.xcodeproj"
SCHEME = "TextreamiOS"
CONFIGURATION = "AppStore"
TEAM_ID = "RJA7656U34"
APP_IDENTIFIER = "dev.fka.textream"

def asc_key_path
  File.expand_path(ENV.fetch("ASC_KEY_PATH"))
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: asc_key_path
  )
end

def app_build_setting(name)
  project = Xcodeproj::Project.open(File.expand_path("../#{PROJECT}", __dir__))
  target = project.targets.find { |candidate| candidate.name == SCHEME }
  target.build_configurations
    .find { |configuration| configuration.name == CONFIGURATION }
    .build_settings
    .fetch(name)
end

platform :ios do
  desc "Archive, upload, and submit the iOS app for App Review"
  desc "The update is released automatically once App Review approves it"
  lane :release do
    ipa = archive_build
    upload_build(ipa: ipa)
    submit_build
  end

  desc "Archive the iOS app and export an App Store IPA"
  lane :archive_build do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      # The API key cannot use cloud signing, so export with the team's
      # existing App Store profile and the Apple Distribution certificate in
      # the keychain.
      export_options: {
        teamID: TEAM_ID,
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("TEXTREAM_IOS_PROFILE", "Textream iOS App Store")
        },
        manageAppVersionAndBuildNumber: false
      },
      output_directory: ENV.fetch("TEXTREAM_RELEASE_OUTPUT", "build/ios-release"),
      clean: true,
      # The archive signs automatically; let Xcode fetch a profile with the key.
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{asc_key_path.shellescape}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID').shellescape}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID').shellescape}"
      ].join(" ")
    )
  end

  desc "Upload an exported IPA to App Store Connect without submitting it"
  lane :upload_build do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: options[:ipa] || lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Create the App Store version, set What's New, and submit the uploaded build"
  lane :submit_build do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      app_version: app_build_setting("MARKETING_VERSION"),
      build_number: app_build_setting("CURRENT_PROJECT_VERSION"),
      skip_binary_upload: true,
      # Only release_notes.txt lives here, so only What's New is updated.
      metadata_path: File.expand_path("metadata", __dir__),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
